<UserControl x:Class="ChessUI.StartMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300" Height="200">
    <Border Style="{StaticResource BorderStyle}" CornerRadius="10" Padding="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CHESS 2D"  Style="{StaticResource TextStyle}"
                       FontSize="24" Margin="0 0 0 20"
                       HorizontalAlignment="Center"/>

            <Button Content="1 VS 1" Click="PlayerVsPlayer_Click"
                    Style="{StaticResource ButtonStyle}"/>

            <Button Content="HUMAN VS AI" Click="PlayerVsComputer_Click"
                    Style="{StaticResource ButtonStyle}" Margin="0 10 0 0"/>
        </StackPanel>
    </Border>
</UserControl>